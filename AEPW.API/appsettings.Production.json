{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/"
  },
  "Database": {
    "ConnectionString": "",
    "MaxPoolSize": 200,
    "CommandTimeoutSeconds": 30
  },

  "ServiceBus": {

    "QueueName": "aepw-notification"  },

  "KeyVault": {

    "VaultUri": "https://aepw-kv.vault.azure.net/"  },

  "Cors": {
    "AllowedOrigins": [
      "",
      "http://localhost:4200"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "AEPW": "Information"
      }
    }
  }
}
